# ==============================================================================
# WanderInk - Environment Configuration Template
# Copy this file to .env.local and configure your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Authentication (Better Auth)
# ------------------------------------------------------------------------------
# Secret key used to encrypt sessions, cookies, and tokens (minimum 32 characters)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-super-secret-key-min-32-chars"

# Base URL of the application for Better Auth callbacks and trusted origins
BETTER_AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Database (MongoDB)
# ------------------------------------------------------------------------------
# MongoDB connection URI (Atlas connection string or local MongoDB instance)
# Note: Used by both Mongoose and the Better Auth native MongoDB adapter
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/wanderink"

# ------------------------------------------------------------------------------
# Storage (Cloudflare R2 - S3-Compatible Object Storage)
# ------------------------------------------------------------------------------
# Cloudflare Account ID (found on your Cloudflare dashboard overview or R2 page)
R2_ACCOUNT_ID="your-cloudflare-account-id"

# Cloudflare R2 API Token Access Key ID
R2_ACCESS_KEY_ID="your-r2-access-key-id"

# Cloudflare R2 API Token Secret Access Key
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"

# Cloudflare R2 Bucket name
R2_BUCKET_NAME="wanderink-images"

# Public R2 bucket or custom domain URL for publicly accessible adventure photos
# Example: "https://pub-xxxxxxxxxxxxxxxx.r2.dev" or "https://media.yourdomain.com"
R2_PUBLIC_URL="https://pub-your-bucket-id.r2.dev"

# ------------------------------------------------------------------------------
# Application URL
# ------------------------------------------------------------------------------
# Publicly accessible URL of the Next.js app (used by client-side auth & sharing)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# AI Service (Self-Hosted OmniRoute / LLM Gateway)
# ------------------------------------------------------------------------------
# Base URL for OpenAI-compatible completions API (e.g., OmniRoute on VM)
OMNIROUTE_BASE_URL="http://your-vm-ip:8000/v1"

# Authorization bearer API key for OmniRoute
OMNIROUTE_API_KEY="your-omniroute-api-key"

# Vision model for multi-photo visual feature extraction (e.g., qwen2.5-vl-72b)
VISION_MODEL="qwen2.5-vl-72b"

# Text model for creative first-person journal story generation (e.g., gemma-2-27b)
STORY_MODEL="gemma-2-27b"
